    "_deadline_readme": "'immediate start', 'start immediately', 'asap start' and 'as soon as possible' were REMOVED from deadline_or_start. They are urgency, not a date: 'immediate start' is what a posting says when it has been open for eight months, while 'applications close 14 March' is evidence of a real, time-bound process. Counting both as 'has a deadline' put two opposite ideas in one feature. Tried as a separate urgency feature, it measured as one of the WORST additions to the model, so it is simply gone rather than split out."
  },
  "patterns": {
    "_readme": "Regular expressions, applied to the normalized text with case-insensitive matching. Each is written to be valid in both Python and JavaScript.",
    "salary_amount": {
      "regex": "\\$\\s?\\d{1,3}(?:\\.\\d{1,2})?\\s?(?:\\/|per\\s|an\\s)\\s?(?:hr|hour|hourly)|\\$\\s?\\d{2,3}\\s?k\\b|\\$\\s?\\d{2,3},\\d{3}|\\d{2,3},\\d{3}\\s?(?:-|to|\\u2013)\\s?\\d{2,3},\\d{3}|(?:salary|compensation|pay|base|rate|range)[^.]{0,40}?\\d{2,3},?\\d{3}",
      "description": "A real pay figure: an hourly rate ($45/hr), an annual amount ($80k, $80,000), a bare range (80,000-95,000), or a number near a pay word. Deliberately does NOT match a bare '$5' or '$10 million', so funding announcements and perks are not mistaken for salary."
    },
    "contact_email": {
      "regex": "[a-z0-9._%+\\-]+@[a-z0-9.\\-]+\\.[a-z]{2,}",
      "description": "An email address, suggesting a named human to reach. Runs on lowercased text, so no uppercase ranges are needed."
    },
    "years_required": {
      "regex": "(\\d{1,2})\\s?\\+?\\s?(?:-|to|\\u2013)?\\s?(?:\\d{1,2})?\\s?(?:\\+)?\\s?years?(?:\\s?(?:of|\\u2019s|'s))?\\s?(?:relevant\\s|professional\\s|industry\\s|hands-on\\s)?experience",
      "description": "Captures the first number in phrases like '5+ years of experience' or '3-5 years experience'. Used with the entry_level list to spot a posting that asks for senior experience at a junior title."
    }
  },
  "thresholds": {
    "_readme": "Numbers that would otherwise be buried in the code.",
    "experience_mismatch_years": 3,
    "_experience_mismatch_years_note": "An 'entry level' posting demanding this many years or more counts as a mismatch. 3 is the common rule of thumb for an unfillable posting."
  }
